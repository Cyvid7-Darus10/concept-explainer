{
  "name": "concept-explainer",
  "version": "0.1.0",
  "description": "An agent skill that explains a repo, a PR, a change, a proposal, a migration, an incident or a concept as one interactive page: diagrams first, broken into parts, every claim cited.",
  "type": "module",
  "bin": {
    "concept-explainer": "bin/concept-explainer.mjs",
    "repo-explainer": "bin/repo-explainer.mjs"
  },
  "files": [
    "bin/",
    "scripts/lib/",
    "template/",
    "presets/",
    "patterns/",
    "assets/",
    "references/",
    "rules/",
    "SKILL.md",
    "NOTICE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "build:example": "node bin/concept-explainer.mjs build examples/taskflow.explainer.json --no-library --style clean",
    "build:gallery": "node bin/concept-explainer.mjs gallery --out examples/gallery.html",
    "build:assets": "node bin/concept-explainer.mjs assets --out assets",
    "check": "npm test && npm run build:example && npm run build:gallery"
  },
  "engines": {
    "node": ">=18.3"
  },
  "keywords": [
    "agent-skill",
    "claude-code",
    "explainer",
    "codebase",
    "pull-request",
    "architecture",
    "diagrams",
    "onboarding",
    "documentation",
    "developer-experience"
  ],
  "license": "Apache-2.0",
  "author": "Cyrus David Pastelero",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cyvid7-Darus10/repo-explainer.git"
  },
  "bugs": {
    "url": "https://github.com/Cyvid7-Darus10/repo-explainer/issues"
  },
  "homepage": "https://github.com/Cyvid7-Darus10/repo-explainer#readme"
}
